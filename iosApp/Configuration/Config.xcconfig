// Per-developer signing settings. Defaults below build for the iOS Simulator
// with no Apple account. To run on a real device, copy
// LocalSigning.xcconfig.template to LocalSigning.xcconfig (gitignored) and set
// your own values there -- see docs/platform-builds/ios.md.
TEAM_ID=
BUNDLE_ID_PREFIX=com.jabramson
#include? "LocalSigning.xcconfig"

PRODUCT_NAME=iperf3KMP
PRODUCT_BUNDLE_IDENTIFIER=$(BUNDLE_ID_PREFIX).iperf3-network-tester-kmp

CURRENT_PROJECT_VERSION=10001
MARKETING_VERSION=1.0.1
